# Relative paths are resolved from the repository root by run.sh.
KASSA_RUNTIME=backend/runtime
KASSA_MODELS_DIR=backend/models
KASSA_VLM_CHECKPOINT=backend/models/vlm
KASSA_UI_DIST=frontend/dist

# Leave empty to generate and retain a random key in KASSA_RUNTIME/api.key.
# Never commit .env, credentials or api.key.
KASSA_API_KEY=

KASSA_GPU=auto
KASSA_API_HOST=127.0.0.1
KASSA_API_PORT=18861
KASSA_API_URL=http://127.0.0.1:18861
KASSA_UI_HOST=127.0.0.1
KASSA_UI_PORT=18863

# Optional: existing compatible Python environment instead of .venv/bin/python.
# KASSA_PYTHON=/absolute/path/to/python

# Shared by the integrated and standalone annotation workstation.
ANNOTATION_DATASET=data/dataset
ANNOTATION_RUNTIME=backend/runtime/annotations
ANNOTATION_PORT=18862

# Optional external text classification (disabled unless invoked explicitly).
NACE_API_KEY=
